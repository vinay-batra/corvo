# Corvo backend environment. Copy to backend/.env and fill in real values.
# Never commit the real .env - it is gitignored. Secrets are injected via
# `fly secrets` (Fly) / the Railway dashboard in production, not from a file.

# --- Supabase (backend uses the SERVICE ROLE key - keep it secret, server-only) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- AI / data providers ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
FINNHUB_API_KEY=your_finnhub_key_here

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=brief@corvo.capital

# --- Web Push (VAPID) ---
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_EMAIL=mailto:you@example.com

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=production

# NOTE: CORS origins are HARDCODED in backend/main.py (_ALLOWED_ORIGINS).
# The app does NOT read an ALLOWED_ORIGINS env var - setting one here has no
# effect. To change the allowed origins, edit _ALLOWED_ORIGINS in main.py.
# ALLOWED_ORIGINS=http://localhost:3000,https://corvo.capital
